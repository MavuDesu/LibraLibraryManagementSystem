<Window x:Class="LibraLibraryManagementSystem.Windows.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraLibraryManagementSystem.Windows"
        mc:Ignorable="d"
        Title="Edit User" Height="450" Width="800" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="EDIT USER" 
               FontSize="20" FontWeight="Bold" Margin="0,0,0,20" 
               Foreground="{StaticResource DarkText}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="School ID"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="txtSchoolID" Margin="0,5,0,5" IsReadOnly="True" Background="#EEEEEE"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Name"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="txtName" Margin="0,5,0,5"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Email"/>
                <TextBox Grid.Row="2" Grid.Column="1" Name="txtEmail" Margin="0,5,0,5"/>

                <Label Grid.Row="3" Grid.Column="0" Content="Contact No."/>
                <TextBox Grid.Row="3" Grid.Column="1" Name="txtContactNo" Margin="0,5,0,5"/>

                <Label Grid.Row="4" Grid.Column="0" Content="Grade and Section"/>
                <TextBox Grid.Row="4" Grid.Column="1" Name="txtGradeSection" Margin="0,5,0,5"/>

                <Label Grid.Row="5" Grid.Column="0" Content="Password"/>
                <PasswordBox Grid.Row="5" Grid.Column="1" Name="txtPassword" Margin="0,5,0,5"/>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="20,0,0,0">
                <Label Content="User Type"/>
                <RadioButton Name="rbStandard" Content="Standard" IsChecked="True" Margin="0,5,0,5"/>
                <RadioButton Name="rbAdmin" Content="Admin" Margin="0,5,0,5"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
            <Button Name="btnSave" Content="SAVE" Margin="0,0,10,0" 
                Background="{StaticResource AccentOrange}" 
                Click="BtnSave_Click" Height="35" MinWidth="100"/>

            <Button Name="btnCancel" Content="CANCEL" 
                Background="{StaticResource ButtonGray}" 
                Click="BtnCancel_Click" Height="35" MinWidth="100"/>
        </StackPanel>

    </Grid>
</Window>
