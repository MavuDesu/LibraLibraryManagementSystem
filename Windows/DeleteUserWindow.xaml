<Window x:Class="LibraLibraryManagementSystem.Windows.DeleteUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraLibraryManagementSystem.Pages"
        mc:Ignorable="d"
        Title="Confirm Deletion" Height="220" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">


    <Border Background="White" CornerRadius="10" Padding="25">

        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="15" Color="#888888" Opacity="0.3"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Confirm deletion of this member." 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10"
                   Foreground="{StaticResource DarkText}"
                   TextWrapping="Wrap"/>

            <TextBlock Text="Once deleted, this account will be permanently removed." 
                   Margin="0,0,0,25"
                   Foreground="{StaticResource TextGray}"
                   TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="btnDeleteConfirm" 
                    Content="DELETE" 
                    Margin="0,0,10,0" 
                    Background="{StaticResource AccentRed}"
                    Click="BtnDeleteConfirm_Click"
                    Height="35" MinWidth="100"/>

                <Button Name="btnCancel" 
                    Content="CANCEL" 
                    Background="{StaticResource ButtonGray}"
                    Click="BtnCancel_Click"
                    Height="35" MinWidth="100"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
