<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
	<connectionStrings>
		<add name="DefaultConnection"
	 connectionString="Server=tcp:mcesilibrary.database.windows.net,1433;Initial Catalog=Library;Persist Security Info=False;User ID=MCESI;Password={your_password};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
	 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>